<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 실행 진입점(WinExe)이 아니라 라이브러리 — Windows 실행 진입점은 App.Windows 프로젝트.
         App.UI 자체는 플랫폼 구현(App.Platform.Windows 등)을 참조하지 않아야 Mac 이식 시 그대로 재사용 가능. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 캐릭터팩은 이용자가 직접 수정/교체할 수 있어야 하므로 AvaloniaResource(어셈블리 내장)가 아니라
         일반 파일로 빌드 출력에 복사한다. -->
    <Content Include="..\..\assets\characters\**\*">
      <Link>CharacterPacks\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Core\App.Core.csproj" />
    <ProjectReference Include="..\App.Platform\App.Platform.csproj" />
    <!-- TODO: 임시 배선. DI 컨테이너가 생기면 정식 조립 방식으로 교체 -->
    <ProjectReference Include="..\App.Platform.Stub\App.Platform.Stub.csproj" />
  </ItemGroup>
</Project>
