<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="App.UI.Views.CharacterWindow"
        Title="캐릭터"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">

    <!-- 타이틀바/테두리 없는 투명 오버레이 창. 이동은 OS가 해주지 않으므로 코드 비하인드에서 BeginMoveDrag로 직접 처리한다.
         Viewbox가 표시 배율(50~200%)을 적용하고, 안쪽 Canvas는 항상 원본 PNG 100% 좌표계를 유지한다 —
         매니페스트의 offset/touchRegion 좌표가 배율과 무관하게 그대로 맞는다. -->
    <Viewbox Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality">
        <!-- baseImage 위에 눈 깜빡임/표정 오버레이를 offset 좌표로 얹는 캔버스. 배경이 없으면 빈 영역에서 포인터 이벤트가 안 잡힌다. -->
        <Canvas x:Name="RootCanvas" Background="Transparent">
            <Image x:Name="BaseLayer" Stretch="None" />
            <Image x:Name="EyeClosedLayer" Stretch="None" IsVisible="False" />
            <Image x:Name="ExpressionLayer" Stretch="None" IsVisible="False" />
        </Canvas>
    </Viewbox>
</Window>
