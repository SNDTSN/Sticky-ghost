<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:App.UI.ViewModels"
        xmlns:conv="using:App.UI.Converters"
        x:Class="App.UI.Views.MemoWindow"
        x:DataType="vm:MemoNoteViewModel"
        Width="220" Height="220"
        SystemDecorations="None"
        Topmost="{Binding IsPinned}"
        Title="메모">

    <!-- SystemDecorations="None"이라 OS 타이틀바(및 그 자체 닫기 버튼)가 없다.
         닫기는 아래 커스텀 ✕ 버튼(RequestCloseCommand) 하나뿐이라 확인 대화상자를 우회할 경로가 없다.
         대신 이동/리사이즈를 OS가 대신 해주지 않으므로 헤더 드래그(BeginMoveDrag)와
         우측 하단 리사이즈 그립(BeginResizeDrag)을 코드 비하인드에서 직접 구현한다. -->
    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
    </Window.Resources>

    <Panel>
        <Grid RowDefinitions="Auto,*" Background="{Binding ColorHex, Converter={StaticResource HexColorToBrushConverter}}">
            <Border Grid.Row="0" Background="Transparent" PointerPressed="OnHeaderPointerPressed">
                <Panel>
                    <!-- 저장이 실패해 파일에 반영되지 않은 변경이 있을 때만 보인다(KNOWN_ISSUES #28 A-5). 다음 저장이 성공하면 사라진다.
                         헤더 드래그 영역 안에 있으므로 이 글자를 잡고도 메모를 옮길 수 있다. -->
                    <TextBlock Text="⚠ 저장 안 됨" Foreground="#C0392B" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"
                               IsVisible="{Binding HasSaveError}"
                               ToolTip.Tip="메모를 파일에 저장하지 못했습니다. 다시 입력하면 저장을 재시도합니다. 사유는 app.log에 있습니다." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4" Spacing="4">
                        <ToggleButton Content="📌" IsChecked="{Binding IsPinned}" ToolTip.Tip="항상 위 표시" />
                        <ColorPicker Color="{Binding ColorValue}" ToolTip.Tip="색상 변경" />
                        <Button Content="✕" Command="{Binding RequestCloseCommand}" ToolTip.Tip="닫기" />
                    </StackPanel>
                </Panel>
            </Border>
            <TextBox Grid.Row="1"
                     Text="{Binding Content}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="8" />
        </Grid>

        <TextBlock Text="◢" FontSize="12" Foreground="#55000000"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,1,1" Cursor="BottomRightCorner"
                   PointerPressed="OnResizeGripPointerPressed" />
    </Panel>
</Window>
