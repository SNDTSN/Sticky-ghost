<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="App.UI.Views.SettingsWindow"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="설정">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="OpenAI API 키" FontWeight="Bold" />
        <TextBlock x:Name="StatusText" Foreground="Gray" FontSize="12" />
        <!-- 기존에 저장된 키 값은 보안상 다시 화면에 보여주지 않는다 — 위 StatusText로 저장 여부만 알림 -->
        <TextBox x:Name="ApiKeyTextBox" PasswordChar="●" Watermark="sk-..." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="닫기" Click="OnCloseClick" />
            <Button Content="저장" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
