<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="App.UI.Views.SettingsWindow"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="설정">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="할 일" FontWeight="Bold" />

        <!-- 마감일이 같은 할 일끼리의 사분면 순서(KNOWN_ISSUES #17-1). "중요"/"긴급" 글자는 목록 딱지와 같은 색이다 —
             설정에서 고르는 것이 목록의 어느 딱지인지 바로 이어지게. 문구가 길어 창이 어수선하면 설명부터 줄인다. -->
        <StackPanel Spacing="4">
            <TextBlock Text="마감일이 같은 할 일의 순서" FontSize="12" Foreground="Gray" />

            <RadioButton x:Name="UrgentFirstRadioButton" GroupName="TodoSortOrder">
                <TextBlock><Run Text="긴급" Foreground="Red" /><Run Text=" 먼저" /></TextBlock>
            </RadioButton>
            <TextBlock FontSize="11" Foreground="Gray" Margin="28,0,0,0" TextWrapping="Wrap">
                <Run Text="중요" Foreground="DarkOrange" /><Run Text="+" /><Run Text="긴급" Foreground="Red" /><Run Text=" → " /><Run Text="긴급" Foreground="Red" /><Run Text=" → " /><Run Text="중요" Foreground="DarkOrange" /><Run Text=" → " /><Run Text="없음" />
            </TextBlock>

            <RadioButton x:Name="ImportantFirstRadioButton" GroupName="TodoSortOrder">
                <TextBlock><Run Text="중요" Foreground="DarkOrange" /><Run Text=" 먼저" /></TextBlock>
            </RadioButton>
            <TextBlock FontSize="11" Foreground="Gray" Margin="28,0,0,0" TextWrapping="Wrap">
                <Run Text="중요" Foreground="DarkOrange" /><Run Text="+" /><Run Text="긴급" Foreground="Red" /><Run Text=" → " /><Run Text="중요" Foreground="DarkOrange" /><Run Text=" → " /><Run Text="긴급" Foreground="Red" /><Run Text=" → " /><Run Text="없음" />
            </TextBlock>
            <TextBlock Text="급한 일에 밀려 중요한 일을 놓치기 쉬운 분께 권합니다."
                       FontSize="11" Foreground="Gray" Margin="28,0,0,0" TextWrapping="Wrap" />

            <TextBlock Text="마감일이 가까운 할 일은 이 설정과 상관없이 항상 먼저 옵니다. 마감일 없는 할 일끼리도 이 순서를 따릅니다."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="LLM" FontWeight="Bold" />

        <StackPanel Spacing="4">
            <TextBlock Text="Provider" FontSize="12" Foreground="Gray" />
            <ComboBox x:Name="ProviderComboBox" HorizontalAlignment="Stretch"
                      SelectionChanged="OnProviderChanged">
                <ComboBoxItem Content="OpenAI" Tag="OpenAi" />
                <ComboBoxItem Content="Gemini" Tag="Gemini" />
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="모델명" FontSize="12" Foreground="Gray" />
            <TextBox x:Name="ModelTextBox" Watermark="예: gpt-4o-mini" TextChanged="OnModelTextChanged" />
            <!-- 모델명이 비어 저장이 막혔을 때만 보인다 — 예전에는 조용히 return이라 "저장 버튼이 안 먹는다"로 보였다. -->
            <TextBlock x:Name="ModelErrorText" Foreground="#C0392B" FontSize="12"
                       TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="API 키" FontSize="12" Foreground="Gray" />
            <TextBlock x:Name="StatusText" Foreground="Gray" FontSize="12" />
            <!-- 기존에 저장된 키 값은 보안상 다시 화면에 보여주지 않는다 — 위 StatusText로 저장 여부만 알림 -->
            <TextBox x:Name="ApiKeyTextBox" PasswordChar="●" Watermark="비워두면 기존 키 유지" />
        </StackPanel>

        <TextBlock Text="캐릭터" FontWeight="Bold" />

        <ToggleButton x:Name="CharacterVisibleToggle" Content="캐릭터 표시" Click="OnCharacterVisibleToggled" />

        <StackPanel x:Name="CharacterScalePanel" Spacing="4">
            <TextBlock Text="크기" FontSize="12" Foreground="Gray" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton x:Name="Scale50RadioButton" GroupName="CharacterScale" Content="50%" />
                <RadioButton x:Name="Scale100RadioButton" GroupName="CharacterScale" Content="100%" />
                <RadioButton x:Name="Scale150RadioButton" GroupName="CharacterScale" Content="150%" />
                <RadioButton x:Name="Scale200RadioButton" GroupName="CharacterScale" Content="200%" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="캐릭터팩" FontSize="12" Foreground="Gray" />
            <ComboBox x:Name="CharacterPackComboBox" HorizontalAlignment="Stretch"
                      DisplayMemberBinding="{Binding DisplayName}" />
            <TextBlock Text="'용량 최적화 필요' 표시가 있는 캐릭터는 이미지가 커서 PC 메모리를 많이 사용할 수 있습니다."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock Text="목록에 보이지 않는 캐릭터는 manifest.json이 손상되었거나 형식이 잘못되었거나, 이미지가 PNG가 아닐 수 있습니다. 자세한 사유는 %LocalAppData%\StickyGhost\logs\app.log에 기록됩니다."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 파일에 쓰지 못해 저장이 실패했을 때만 보인다. 창을 닫지 않으므로 입력한 값은 그대로 남는다. -->
        <TextBlock x:Name="SaveErrorText" Foreground="#C0392B" FontSize="12"
                   TextWrapping="Wrap" IsVisible="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="닫기" Click="OnCloseClick" />
            <Button Content="저장" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
