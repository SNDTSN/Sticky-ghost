<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:App.UI.ViewModels"
        xmlns:conv="using:App.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
        x:Class="App.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="400" Height="700"
        Title="Sticky Ghost - To-do">

    <!-- MainViewModel이 리포지토리/서비스 생성자 의존성을 가지므로 Design.DataContext 프리뷰는 생략 -->

    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="+ 할 일 추가">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <ScrollViewer MaxHeight="500">
                                <StackPanel Width="300" Spacing="8">
                                    <TextBox Watermark="할 일 제목" Text="{Binding NewTitle}" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="마감일" FontSize="12" Foreground="Gray" />
                                        <DatePicker SelectedDate="{Binding NewDueDate}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <CheckBox Content="중요" IsChecked="{Binding NewIsImportant}" />
                                        <CheckBox Content="긴급" IsChecked="{Binding NewIsUrgent}" />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding Categories}"
                                              SelectedItem="{Binding SelectedCategory}"
                                              DisplayMemberBinding="{Binding Name}"
                                              PlaceholderText="미분류"
                                              HorizontalAlignment="Stretch" />

                                    <Expander Header="체크리스트" IsExpanded="False">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBox Width="180" Watermark="체크리스트 항목" Text="{Binding NewChecklistText}" />
                                                <Button Content="항목 추가" Command="{Binding AddChecklistItemToDraftCommand}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding NewChecklistItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:CompileBindings="False">
                                                        <Border Background="#EEEEEE" CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                <Button Content="✕" Padding="2"
                                                                        Command="{Binding $parent[Window].DataContext.RemoveChecklistItemFromDraftCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="반복 설정" IsExpanded="False">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <CheckBox Content="반복" IsChecked="{Binding NewIsRecurring}" />
                                            <!-- "3 일 마다"로 읽히게 숫자와 단위를 한 줄에 둔다.
                                                 요일 단위에서는 간격이 의미가 없어 숫자 칸과 "마다"가 사라진다. -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <NumericUpDown Value="{Binding NewRecurrenceInterval}" Minimum="1"
                                                               IsEnabled="{Binding NewIsRecurring}"
                                                               IsVisible="{Binding IsIntervalVisible}"
                                                               FormatString="0" Width="110" />
                                                <ComboBox ItemsSource="{Binding RecurrenceUnitOptions}"
                                                          SelectedItem="{Binding SelectedRecurrenceUnit}"
                                                          DisplayMemberBinding="{Binding Label}"
                                                          IsEnabled="{Binding NewIsRecurring}"
                                                          Width="86" />
                                                <TextBlock Text="마다" VerticalAlignment="Center"
                                                           IsVisible="{Binding IsIntervalVisible}" />
                                            </StackPanel>
                                            <!-- 달 단위는 "마감일과 같은 날"과 "매달 말일"이 갈린다 — 요일 피커와 같은 방식으로
                                                 단위에 따라 나타나는 보조 입력으로 뒀다. -->
                                            <StackPanel Spacing="2" IsVisible="{Binding IsMonthDayModeVisible}">
                                                <RadioButton GroupName="MonthDayMode" Content="{Binding MonthSameDayLabel}"
                                                             IsChecked="{Binding !NewRecurMonthEndMode}"
                                                             IsEnabled="{Binding NewIsRecurring}" />
                                                <RadioButton GroupName="MonthDayMode" Content="매달 말일"
                                                             IsChecked="{Binding NewRecurMonthEndMode}"
                                                             IsEnabled="{Binding NewIsRecurring}" />
                                            </StackPanel>
                                            <!-- 목록에 뜰 문구를 그대로 미리 보여준다(RecurrenceSummaryFormatter 공용). -->
                                            <TextBlock Text="{Binding RecurrencePreview}" Foreground="SteelBlue"
                                                       FontSize="12" TextWrapping="Wrap" />
                                            <!-- 의도와 어긋날 수 있는 조합의 안내. 입력을 막지는 않는다. -->
                                            <TextBlock Text="{Binding RecurrenceWarning}" IsVisible="{Binding HasRecurrenceWarning}"
                                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="반복 종료일" FontSize="12" Foreground="Gray" />
                                                <DatePicker SelectedDate="{Binding NewRecurrenceEndDate}" IsEnabled="{Binding NewIsRecurring}" />
                                            </StackPanel>

                                            <StackPanel Spacing="4" IsVisible="{Binding IsWeekdayPickerVisible}">
                                                <ItemsControl ItemsSource="{Binding RecurrenceDayOptions}" IsEnabled="{Binding NewIsRecurring}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DayOfWeekOptionViewModel">
                                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding HasErrorMessage}"
                                               TextWrapping="Wrap" />

                                    <Button Content="추가" Command="{Binding AddTodoCommand}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Content="카테고리 관리">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="260" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="160" Watermark="카테고리 이름" Text="{Binding NewCategoryName}" />
                                    <Button Content="추가" Command="{Binding AddCategoryCommand}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryViewModel">
                                            <Border Background="#EEEEEE" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <ColorPicker Color="{Binding ColorValue}" />
                                                    <TextBox Text="{Binding Name}" Width="130" />
                                                    <Button Content="✕" Padding="2" Command="{Binding DeleteCommand}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- TODO: 트레이 아이콘 설계 전까지 메모 위젯 수동 확인용 임시 버튼 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="새 메모" Click="OnNewMemoClick" HorizontalAlignment="Left" />
            <Button Content="설정" Click="OnSettingsClick" HorizontalAlignment="Left" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TodoItemViewModel">
                    <StackPanel Spacing="2" Margin="0,6">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="4,0" />
                            <TextBlock Grid.Column="2" Text="{Binding DueDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                       VerticalAlignment="Center" FontSize="11" Foreground="Gray" />
                            <Button Grid.Column="3" Content="✕" Padding="2" Margin="6,0,0,0"
                                    Command="{Binding DeleteCommand}" />
                        </Grid>
                        <WrapPanel Margin="28,0,0,0">
                            <TextBlock Text="중요" IsVisible="{Binding IsImportant}" Foreground="DarkOrange"
                                       FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="긴급" IsVisible="{Binding IsUrgent}" Foreground="Red"
                                       FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding RecurrenceSummary}" IsVisible="{Binding HasRecurrence}" Foreground="SteelBlue"
                                       FontSize="11" Margin="0,0,6,0" />
                            <Border IsVisible="{Binding HasCategory}"
                                    Background="{Binding CategoryColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                    CornerRadius="3" Padding="4,1">
                                <TextBlock Text="{Binding CategoryName}" FontSize="11" />
                            </Border>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding ChecklistItems}" Margin="28,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChecklistItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <CheckBox IsChecked="{Binding IsChecked}" />
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
