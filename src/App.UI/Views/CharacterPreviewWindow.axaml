<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="App.UI.Views.CharacterPreviewWindow"
        Title="캐릭터 미리보기"
        SizeToContent="WidthAndHeight"
        CanResize="False">

    <!-- baseImage 위에 눈 깜빡임/표정 오버레이를 offset 좌표로 얹는 캔버스 -->
    <Canvas x:Name="RootCanvas">
        <Image x:Name="BaseLayer" Stretch="None" />
        <Image x:Name="EyeClosedLayer" Stretch="None" IsVisible="False" />
        <Image x:Name="ExpressionLayer" Stretch="None" IsVisible="False" />
    </Canvas>
</Window>
